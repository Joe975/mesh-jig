# Copy this file to .env (git ignores it) and fill in what you use. mesh-jig reads these from the environment and
# fills the unset ones from .env in the directory it is run from, or from the file named by MESH_JIG_ENV_FILE.
# Only `mesh-jig judge`, `eval --judge` and `mesh-jig agent` need any.

# The pairwise judge: any OpenAI-compatible endpoint serving a vision model.
# MESH_JIG_JUDGE_URL=https://openrouter.ai/api/v1
# MESH_JIG_JUDGE_MODEL=deepseek/deepseek-v4.1-flash
# MESH_JIG_JUDGE_KEY=
# With the default OpenRouter URL, OPENROUTER_API_KEY is used when MESH_JIG_JUDGE_KEY is unset.
# OPENROUTER_API_KEY=

# `mesh-jig agent`: the model that writes the scripts. Same rules; it has no default model.
# MESH_JIG_AGENT_URL=https://openrouter.ai/api/v1
# MESH_JIG_AGENT_MODEL=
# MESH_JIG_AGENT_KEY=
# Without a *_KEY the provider's own variable is used, by the URL's host: OPENROUTER_API_KEY, ANTHROPIC_API_KEY,
# GEMINI_API_KEY, else OPENAI_API_KEY.

# Blender, when it is not on PATH or in the usual install place.
# MESH_JIG_BLENDER=/path/to/blender
